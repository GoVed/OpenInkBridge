{
  "schemaVersion": 1,
  "setWritingMode": {
    "protocolVersion": 1,
    "type": "setWritingMode",
    "sessionId": "session-contract",
    "canvasId": "canvas-contract",
    "enabled": true,
    "color": "#123456",
    "width": 7,
    "stylusOnly": true,
    "rect": { "left": 10, "top": 20, "width": 300, "height": 200 }
  },
  "strokeDrawn": {
    "protocolVersion": 1,
    "type": "strokeDrawn",
    "sessionId": "session-contract",
    "canvasId": "canvas-contract"
  },
  "strokeFinished": {
    "protocolVersion": 1,
    "type": "strokeFinished",
    "sessionId": "session-contract",
    "canvasId": "canvas-contract",
    "payload": {
      "points": [
        { "x": 1, "y": 2, "pressure": 0.5, "tilt": 0, "timestamp": 42 }
      ]
    }
  }
}
